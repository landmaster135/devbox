# syntax=docker/dockerfile:1

# ビルドステージ: cron-workflow CLI をビルド
FROM golang:1.25-bookworm AS builder
WORKDIR /workspace

# 依存関係を先にダウンロードしてキャッシュ効率を高める
COPY go.mod go.sum ./
RUN go mod download

# プロジェクト全体をコピーしてビルド
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags="-s -w" -o /workspace/bin/cron-workflow ./cmd/cli/cron-workflow

# 実行ステージ: Debian Slim（bookwormに合わせる）
FROM debian:bookworm-slim

# 必要最小限のパッケージをインストール
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    gnupg && \
    curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
      | gpg --dearmor -o /usr/share/keyrings/postgresql.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/postgresql.gpg] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    lm-sensors \
    postgresql-client-common \
    postgresql-client-18 \
    tzdata && \
    rm -rf /var/lib/apt/lists/*

# PostgreSQL の pg_dump を優先的に参照させる
ENV PATH="/usr/lib/postgresql/18/bin:${PATH}"

# イメージビルド時に pg_dump の存在とバージョンを検証
RUN pg_dump --version
RUN sensors -v

WORKDIR /app

# 非rootユーザーを作成
RUN groupadd -g 65532 nonroot && \
    useradd -u 65532 -g nonroot -s /bin/bash -m nonroot

COPY --from=builder /workspace/bin/cron-workflow /app/cron-workflow
RUN chown -R nonroot:nonroot /app

USER nonroot

ENTRYPOINT ["/app/cron-workflow"]
