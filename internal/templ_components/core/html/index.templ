package html

templ Document(lang string, children ...templ.Component) {
  <!DOCTYPE html>
  if lang == "" {
    <html>
      for _, child := range children {
        if child != nil {
          @child
        }
      }
    </html>
  } else {
    <html lang={ lang }>
      for _, child := range children {
        if child != nil {
          @child
        }
      }
    </html>
  }
}
