package div

templ Tag(class string, children ...templ.Component) {
  if class == "" {
    <div>
      for _, child := range children {
        if child != nil {
          @child
        }
      }
    </div>
  } else {
    <div class={ class }>
      for _, child := range children {
        if child != nil {
          @child
        }
      }
    </div>
  }
}
