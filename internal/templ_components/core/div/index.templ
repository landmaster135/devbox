package div

templ Tag(class string, children ...templ.Component) {
  if class == "" {
    <div>
      if len(children) > 0 {
        for _, child := range children {
          if child != nil {
            @child
          }
        }
      }
    </div>
  } else {
    <div class={ class }>
      if len(children) > 0 {
        for _, child := range children {
          if child != nil {
            @child
          }
        }
      }
    </div>
  }
}
