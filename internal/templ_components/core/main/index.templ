package main_component

templ Tag(class string, children ...templ.Component) {
  if class == "" {
    <main>
      if len(children) > 0 {
        for _, child := range children {
          if child != nil {
            @child
          }
        }
      }
    </main>
  } else {
    <main class={ class }>
      if len(children) > 0 {
        for _, child := range children {
          if child != nil {
            @child
          }
        }
      }
    </main>
  }
}
