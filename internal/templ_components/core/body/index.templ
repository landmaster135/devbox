package body

templ Tag(class string, children ...templ.Component) {
  if class == "" {
    <body>
      for _, child := range children {
        if child != nil {
          @child
        }
      }
    </body>
  } else {
    <body class={ class }>
      for _, child := range children {
        if child != nil {
          @child
        }
      }
    </body>
  }
}
