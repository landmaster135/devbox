ARG GO_VERSION=1.25
FROM golang:${GO_VERSION}-bookworm

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    ffmpeg \
    git \
    libtesseract-dev \
    libleptonica-dev \
    tesseract-ocr \
    xdg-utils \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
